# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.env
.env.*
!.env.example
/.shared-test-profile.json
/device-profiles/*.json
# Firebase client configuration is injected per environment and should not be
# committed with the app source tree.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
node_modules/
.pub-cache/
.pub/
/build/
/coverage/

# Local captures, generated previews, and temporary environments
/artifacts/
/tmp/

# Deployed legal/support site is maintained as its own Git repository.
/legal-site/

# Unused local pixel-art prototypes
/assets/images/dinosaur_side_left_*.png
/assets/images/dodge_brown_*.png
/assets/images/player_dino_idle_32*.png
/assets/images/reference_pixel_*.png

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Flutter test failure captures are regenerated by visual tests
/test/**/failures/
